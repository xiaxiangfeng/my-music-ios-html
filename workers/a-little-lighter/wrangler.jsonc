{
  "name": "a-little-lighter",
  "compatibility_date": "2026-11-12",
  "routes": [
    { "pattern": "a-little-lighter.annibao.top", "custom_domain": true }
  ],
  "main": "app-store.mjs",
  "assets": {
    "directory": "../../docs/a-little-lighter",
    "binding": "ASSETS",
    "run_worker_first": ["/app-store", "/app-store/"],
    "html_handling": "auto-trailing-slash"
  }
}
